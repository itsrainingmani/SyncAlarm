name: Validate
on: [push, pull_request]
jobs:
  validate:
    runs-on: macos-15
    steps:
      - uses: actions/checkout@v4
      - name: Test storage and sync
        run: swift test
      - name: Compile both app targets
        run: Scripts/check-apps.sh
      - name: Generate project
        run: |
          brew install xcodegen
          xcodegen generate
      - name: Build phone and embedded watch app
        run: xcodebuild -project SyncAlarm.xcodeproj -scheme SyncAlarm -configuration Debug -destination 'generic/platform=iOS' CODE_SIGNING_ALLOWED=NO build
